#!/home/eisenaj/code/JacobianODE/.venv/bin/python
"""engaging-controller — the engaging-side cron driver for git-based sweep automation.

Once per cron tick (~5 min), this script:
  1. flock to prevent overlap
  2. git pull jacobian-reports
  3. process new instructions/pending/*.yaml: run prepare_sweep + jsweep locally,
     move file to instructions/claimed/ (annotated) or instructions/failed/.
  4. invoke JacobianODE.jacobians.tuning.monitor (writes /orcd state.json + sentinels)
  5. dispatch analysis sbatch for any new sentinels in /orcd/.../sweeps/done/
  6. reap completed analysis sbatches: render report, copy into the repo, mv sentinel
  7. write/update status/overview.json (only if changed)
  8. git add+commit+push (rebase-and-retry on rejection)

Replaces the previous endeavour-side SSH+systemd flow. Existing
JacobianODE.jacobians.tuning.{monitor,prepare_sweep,analyze_sweep,render_report}
modules are unchanged — this is a thin orchestrator.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time
import yaml
from datetime import datetime, timezone
from pathlib import Path

# ---------------------------------------------------------------------------
# Paths and constants
# ---------------------------------------------------------------------------
REPO_DIR = Path("/home/eisenaj/code/jacobian-reports")
JACODE_REPO = Path("/home/eisenaj/code/JacobianODE")
SWEEPS_DIR = Path("/orcd/data/ekmiller/001/eisenaj/JacobianODE/sweeps")
STATE_DIR = Path("/home/eisenaj/.engaging-controller")
INFLIGHT_FILE = STATE_DIR / "in_flight.json"
LOCK_FILE = STATE_DIR / "controller.lock"

UV = "/home/eisenaj/.local/bin/uv"
HOSTNAME = socket.gethostname()
SUBMIT_POLL_SEC = 2
SUBMIT_POLL_MAX = 90  # seconds total to wait for jsweep's SLURM jobs to appear
ANALYZE_PARTITION = "ou_bcs_high"  # for analysis sbatch
# Vanilla LitMLP analysis on WMTask is ~100 min (40M params, ~7 s/batch x 100
# batches x 9 runs). Latent runs are much faster but the same timeout is fine.
ANALYZE_TIMEOUT_MIN = 240
ANALYZE_GPUS = 1
ANALYZE_CPUS = 4
ANALYZE_MEM_GB = 16


# ---------------------------------------------------------------------------
# Plumbing
# ---------------------------------------------------------------------------
def utc_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def utc_compact() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def log(msg: str) -> None:
    print(f"[{utc_iso()}] {msg}", flush=True)


CONTROLLER_HOST = "login006"  # pin to one login node to avoid NFS cache races


def acquire_lock():
    # Only run on the pinned host. Other login nodes that cron fires on
    # exit immediately — avoids NFS attribute-cache races where a stale
    # version of this script runs on a different node and overwrites the
    # correct overview.json with outdated data.
    if HOSTNAME != CONTROLLER_HOST:
        sys.exit(0)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    f = open(LOCK_FILE, "w")
    try:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        return f
    except BlockingIOError:
        log("lock held by another instance; exiting")
        sys.exit(0)


def run(cmd, cwd=None, check=True, capture=True, env=None) -> subprocess.CompletedProcess:
    """Thin wrapper around subprocess.run with sensible defaults."""
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        check=check,
        capture_output=capture,
        text=True,
        env=env,
    )


# ---------------------------------------------------------------------------
# Git helpers (jacobian-reports repo)
# ---------------------------------------------------------------------------
def git(*args, check=True) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd=REPO_DIR, check=check)


def git_pull_rebase() -> None:
    git("pull", "--rebase", "--autostash")


def git_pull_jacode() -> None:
    """Pull JacobianODE so the controller picks up code changes (monitor /
    analyze_sweep / prepare_sweep / sweep.py / and the controller itself,
    since it now lives in the repo) without manual SSH intervention."""
    try:
        run(["git", "pull", "--rebase", "--autostash"], cwd=JACODE_REPO, check=True)
    except subprocess.CalledProcessError as e:
        log(f"git pull JacobianODE failed: {(e.stderr or '').strip()[:300]}")


def git_status_dirty() -> bool:
    return bool(git("status", "--porcelain").stdout.strip())


def git_commit_and_push(msg: str, dry_run: bool) -> None:
    if not git_status_dirty():
        return
    git("add", "-A")
    git("commit", "-m", msg)
    if dry_run:
        log("dry-run: skipping push")
        return
    for attempt in range(3):
        try:
            git("pull", "--rebase", "--autostash")
            git("push")
            return
        except subprocess.CalledProcessError as e:
            log(f"push attempt {attempt + 1} failed: {e.stderr.strip()[:200]}")
            time.sleep(2)
    log("push failed after 3 attempts; will retry next cycle")


# ---------------------------------------------------------------------------
# In-flight state
# ---------------------------------------------------------------------------
def load_inflight() -> dict:
    if INFLIGHT_FILE.exists():
        return json.loads(INFLIGHT_FILE.read_text())
    return {}


def save_inflight(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    INFLIGHT_FILE.write_text(json.dumps(state, indent=2))


# ---------------------------------------------------------------------------
# (3) Process pending instructions
# ---------------------------------------------------------------------------
def _read_yaml(path: Path) -> dict:
    return yaml.safe_load(path.read_text())


def _write_yaml(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(yaml.safe_dump(data, sort_keys=False))


def _git_head_info() -> tuple[str, str]:
    branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=JACODE_REPO).stdout.strip()
    commit = run(["git", "rev-parse", "--short", "HEAD"], cwd=JACODE_REPO).stdout.strip()
    return branch, commit


def _current_array_jobs() -> set[str]:
    """Return the set of SLURM array job IDs currently visible in our queue."""
    try:
        out = run(
            ["squeue", "-u", os.environ.get("USER", "eisenaj"), "-h", "-o", "%i"],
            check=False,
        ).stdout
    except FileNotFoundError:
        return set()
    ids = set()
    for line in out.splitlines():
        m = re.match(r"(\d+)", line.strip())
        if m:
            ids.add(m.group(1))
    return ids


def _submit_one(
    exp: str,
    overrides: list[str],
    two_stage: dict | None = None,
) -> dict:
    """Run prepare_sweep + jsweep for one experiment. Returns dict of metadata
    including the SLURM array id (or raises on failure).

    ``two_stage`` is the opt-in block from the instruction YAML (see the
    two-stage protocol). When present, it's persisted into ``expected.json``
    so ``_maybe_dispatch_stage_b`` can find it after analysis publishes.
    """
    branch, commit = _git_head_info()
    expected_path = STATE_DIR / "expected_tmp.json"
    expected_path.parent.mkdir(parents=True, exist_ok=True)

    # 1. prepare_sweep validates metadata + writes expected.json
    cmd = [
        UV, "run", "--no-sync", "python", "-m",
        "JacobianODE.jacobians.tuning.prepare_sweep",
        "--git-branch", branch,
        "--git-commit", commit,
        "--git-repo-dir", str(JACODE_REPO),
        "--launched-from", HOSTNAME,
        "--output", str(expected_path),
        "--", f"experiment={exp}", *overrides,
    ]
    run(cmd, cwd=JACODE_REPO)

    expected = json.loads(expected_path.read_text())
    group = expected["wandb"].get("group")
    if not group:
        raise RuntimeError("expected.json has no wandb_group")
    batch_count = expected.get("expected_run_count") or len(
        expected["hydra"]["resolved_runs"]
    )

    # 2. Pick up sweep_grid args from the YAML so user doesn't need to
    #    repeat them on the CLI.
    sg = run(
        [UV, "run", "--no-sync", "python", "-m",
         "JacobianODE.jacobians.tuning.prepare_sweep",
         "--print-sweep-args", "--",
         f"experiment={exp}", *overrides],
        cwd=JACODE_REPO, check=False,
    ).stdout.strip()
    sg_args = shlex.split(sg) if sg else []

    # 3. Submit jsweep (Hydra multirun + submitit). Capture SLURM array id by
    #    polling squeue for new IDs.
    before = _current_array_jobs()
    jsweep_cmd = [
        "bash", "-l", "-c",
        f"cd {JACODE_REPO} && OPENBLAS_NUM_THREADS=4 jsweep "
        + shlex.join([f"experiment={exp}", *overrides, *sg_args])
    ]
    proc = subprocess.Popen(
        jsweep_cmd,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )

    array_id = None
    deadline = time.time() + SUBMIT_POLL_MAX
    stable_polls = 0
    prev_new = 0
    while time.time() < deadline:
        time.sleep(SUBMIT_POLL_SEC)
        after = _current_array_jobs()
        new = after - before
        if new:
            if len(new) == prev_new:
                stable_polls += 1
            else:
                stable_polls = 0
            prev_new = len(new)
            if stable_polls >= 3:
                # Pick the lowest new array id (jsweep typically submits one)
                array_id = sorted(new)[0]
                break
    # Cleanup: jsweep often hangs after submitit returns; kill it
    proc.terminate()
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        proc.kill()

    if not array_id:
        # Clean up the temp expected.json — do NOT touch final_expected so a
        # failed submission doesn't leave orphan resolved_runs in it that a
        # later submission would mistake for a live sweep and extend from.
        try:
            expected_path.unlink(missing_ok=True)
        except Exception:
            pass
        raise RuntimeError(
            f"jsweep submission for {exp}: no new SLURM array job appeared within "
            f"{SUBMIT_POLL_MAX}s"
        )

    # 4. jsweep succeeded — finalize expected.json. If this group's
    #    expected.json already exists from a prior SUCCESSFUL submission,
    #    EXTEND it: offset the new resolved_runs' run_idx so they don't
    #    collide with previously-tracked runs (whose terminal flags live in
    #    state.json). This lets the monitor count old completed runs + new
    #    in-flight runs together. If this is the first successful submission
    #    for the group, just move the temp into place.
    SWEEPS_DIR.joinpath("active").mkdir(parents=True, exist_ok=True)
    final_expected = SWEEPS_DIR / "active" / f"{group}.expected.json"
    if final_expected.is_file():
        old = json.loads(final_expected.read_text())
        old_runs = old.get("hydra", {}).get("resolved_runs", [])

        def _matchable_overrides(run: dict) -> tuple:
            """The set of (key, value) pairs that disambiguate sweep cells.
            Hydra-consumed and experiment overrides don't appear in wandb
            configs, so they don't disambiguate runs from each other."""
            ovs = []
            for ov in run.get("overrides", []):
                if "=" not in ov:
                    continue
                k, v = ov.split("=", 1)
                if k.startswith("hydra.") or k == "experiment":
                    continue
                ovs.append((k, v))
            return tuple(sorted(ovs))

        old_keys = {_matchable_overrides(r) for r in old_runs}
        new_keys = [_matchable_overrides(r) for r in expected["hydra"]["resolved_runs"]]
        # If every new resolved_run already has a matching cell in the existing
        # expected.json, this resubmission is a "redo" of the same sweep grid
        # (e.g. partition change, code update). REPLACE the bookkeeping rather
        # than EXTEND — extending only makes sense for adding new sweep axes,
        # since (a) wandb config-matching cannot disambiguate identical-config
        # cells and (b) the new SLURM array's task indices are 0..(N-1), so the
        # alive-task check `{array_id}_{run_idx}` only resolves when run_idx
        # numbering matches array task numbering 1:1.
        is_redo = bool(new_keys) and all(k in old_keys for k in new_keys)
        if is_redo:
            log(
                f"[{exp}] REDO {group}: same sweep grid as existing "
                f"({len(new_keys)} cells). Replacing bookkeeping, not extending."
            )
            # Build a fresh expected.json from the new submission, keeping run_idx
            # numbering 0..(N-1) (matches new array task indices). Carry over
            # experiment_metadata to preserve any prior validation context.
            fresh = json.loads(expected_path.read_text())
            fresh["slurm_arrays"] = {
                str(r["run_idx"]): array_id
                for r in fresh["hydra"]["resolved_runs"]
            }
            # Preserve original launched_at and the first array job id for
            # the timeline / sentinel-eligibility checks downstream.
            fresh.setdefault("first_launched_at", old.get("first_launched_at") or old.get("launched_at"))
            old_meta = old.get("experiment_metadata") or {}
            new_meta = fresh.get("experiment_metadata") or {}
            old_meta.update(new_meta)
            if old_meta:
                fresh["experiment_metadata"] = old_meta
            final_expected.write_text(json.dumps(fresh, indent=2) + "\n")
            expected_path.unlink(missing_ok=True)
            expected_run_count = batch_count
            return {
                "wandb_group": group,
                "expected_run_count": expected_run_count,
                "slurm_array_id": array_id,
                "slurm_submitted_at": utc_iso(),
            }

        next_idx = max((r["run_idx"] for r in old_runs), default=-1) + 1
        appended = [
            {**r, "run_idx": next_idx + r["run_idx"]}
            for r in expected["hydra"]["resolved_runs"]
        ]
        merged = dict(old)
        merged.setdefault("hydra", {})["resolved_runs"] = old_runs + appended
        merged["expected_run_count"] = len(old_runs) + len(appended)
        merged_meta = dict(old.get("experiment_metadata") or {})
        merged_meta.update(expected.get("experiment_metadata") or {})
        if merged_meta:
            merged["experiment_metadata"] = merged_meta
        # Carry over the latest submission's slurm partition (and any other
        # slurm fields prepare_sweep derived from overrides) so monitor retries
        # go to the partition this resubmission actually used, not whatever the
        # first-ever submission used. Without this, a resubmit with
        # hydra.launcher.partition=ou_bcs_low on a sweep whose expected.json
        # already exists will keep firing retries to the old partition.
        new_slurm = expected.get("slurm") or {}
        if new_slurm:
            merged_slurm = dict(merged.get("slurm") or {})
            merged_slurm.update(new_slurm)
            # initial_array_job_id is a one-shot that belongs to the first
            # submission — don't clobber it with the resubmit's placeholder.
            if merged.get("slurm", {}).get("initial_array_job_id") is not None:
                merged_slurm["initial_array_job_id"] = merged["slurm"]["initial_array_job_id"]
            merged["slurm"] = merged_slurm
        # Record the SLURM task_id for this SUBMISSION so monitor can check
        # the original array task's liveness before triggering a retry
        # (prevents monitor from double-scheduling while SLURM REQUEUE is
        # still in-flight). On EXTEND, run_idx is offset by next_idx from
        # the new array's task indices (which always start at 0), so we
        # must store the full task_id `array_id_<task_idx>` — storing only
        # array_id and reconstructing as `array_id_<run_idx>` (the legacy
        # behavior) would point at a non-existent task.
        slurm_arrays = dict(old.get("slurm_arrays") or {})
        for r in appended:
            new_task_idx = r["run_idx"] - next_idx
            slurm_arrays[str(r["run_idx"])] = f"{array_id}_{new_task_idx}"
        merged["slurm_arrays"] = slurm_arrays
        final_expected.write_text(json.dumps(merged, indent=2) + "\n")
        expected_path.unlink(missing_ok=True)
        log(
            f"[{exp}] extended {group}: +{len(appended)} runs "
            f"(total now {merged['expected_run_count']})"
        )
        expected_run_count = batch_count
    else:
        # Stamp the array id on each run_idx before moving into place.
        fresh = json.loads(expected_path.read_text())
        fresh["slurm_arrays"] = {
            str(r["run_idx"]): array_id
            for r in fresh["hydra"]["resolved_runs"]
        }
        expected_path.write_text(json.dumps(fresh, indent=2) + "\n")
        shutil.move(str(expected_path), str(final_expected))
        expected_run_count = batch_count

    # Two-stage protocol: persist the instruction's `two_stage:` block into
    # expected.json so the post-publish hook can find it. Done after both
    # the fresh-write and extend-write branches above so the patch lands
    # regardless of which path created the file.
    if two_stage and final_expected.is_file():
        try:
            doc = json.loads(final_expected.read_text())
            doc["two_stage"] = two_stage
            final_expected.write_text(json.dumps(doc, indent=2) + "\n")
        except Exception as e:
            log(f"[{exp}] WARN failed to persist two_stage block: {e}")

    return {
        "wandb_group": group,
        "expected_run_count": expected_run_count,
        "slurm_array_id": array_id,
        "slurm_submitted_at": utc_iso(),
    }


def process_pending_instructions(dry_run: bool) -> int:
    pending_dir = REPO_DIR / "instructions" / "pending"
    claimed_dir = REPO_DIR / "instructions" / "claimed"
    failed_dir = REPO_DIR / "instructions" / "failed"
    if not pending_dir.exists():
        return 0

    files = sorted(p for p in pending_dir.iterdir() if p.suffix == ".yaml")
    n_processed = 0
    for f in files:
        try:
            data = _read_yaml(f)
        except Exception as e:
            log(f"[{f.name}] FAILED to parse YAML: {e}")
            failed_dir.mkdir(parents=True, exist_ok=True)
            target = failed_dir / f.name
            shutil.move(str(f), str(target))
            try:
                target.write_text(target.read_text() + f"\nerror: parse: {e}\n")
            except Exception:
                pass
            continue

        action = data.get("action", "submit")

        # --- BACKFILL action: re-run only missing analytics sections ---
        if action == "backfill":
            group = data.get("group")
            if not group:
                log(f"[{f.name}] backfill missing 'group'; failing")
                failed_dir.mkdir(parents=True, exist_ok=True)
                shutil.move(str(f), str(failed_dir / f.name))
                continue
            log(f"[{f.name}] backfill group={group}")
            backfill_cmd = [
                UV, "run", "--no-sync", "python", "-m",
                "JacobianODE.jacobians.tuning.analyze_sweep",
                "--backfill", group,
            ]
            # Capture combined stdout+stderr to a per-attempt log inside the
            # analysis dir so failures are visible from the repo (the controller's
            # own stdout only lives in cron logs we usually can't reach). The log
            # file is overwritten by _publish_analysis copytree, so it lands in
            # the repo whether the subprocess succeeded or failed.
            analysis_dir = SWEEPS_DIR / "analysis" / group
            analysis_dir.mkdir(parents=True, exist_ok=True)
            ts_safe = utc_iso().replace(":", "").replace("-", "")
            backfill_log = analysis_dir / f"backfill_{ts_safe}.log"
            backfill_outcome = "ok"
            try:
                with backfill_log.open("w") as logf:
                    logf.write(f"# backfill cmd: {' '.join(backfill_cmd)}\n")
                    logf.write(f"# cwd: {JACODE_REPO}\n")
                    logf.write(f"# started: {utc_iso()}\n\n")
                    logf.flush()
                    subprocess.run(
                        backfill_cmd, cwd=str(JACODE_REPO), check=True,
                        stdout=logf, stderr=subprocess.STDOUT, text=True,
                    )
            except subprocess.CalledProcessError as e:
                backfill_outcome = f"FAILED (exit {e.returncode})"
                with backfill_log.open("a") as logf:
                    logf.write(f"\n# exited: {utc_iso()} — {backfill_outcome}\n")
                log(f"[{f.name}] backfill {backfill_outcome}; see {backfill_log.name}")
            except Exception as e:
                backfill_outcome = f"FAILED ({type(e).__name__})"
                with backfill_log.open("a") as logf:
                    logf.write(
                        f"\n# controller-side exception: {type(e).__name__}: {e}\n"
                    )
                log(f"[{f.name}] backfill FAILED: {e}")
            else:
                with backfill_log.open("a") as logf:
                    logf.write(f"\n# exited: {utc_iso()} — ok\n")
            # Always publish so the log file lands in the repo, even on failure.
            try:
                if (analysis_dir / "metrics.json").exists():
                    _publish_analysis(group)
            except Exception as e:
                log(f"[{f.name}] publish after backfill failed: {e}")
            claimed_dir.mkdir(parents=True, exist_ok=True)
            target = claimed_dir / f.name
            shutil.move(str(f), str(target))
            n_processed += 1
            continue

        # --- Default: SUBMIT action ---
        exp = data.get("experiment")
        if not exp:
            log(f"[{f.name}] missing 'experiment' key; failing")
            failed_dir.mkdir(parents=True, exist_ok=True)
            shutil.move(str(f), str(failed_dir / f.name))
            continue

        overrides = data.get("overrides") or []
        if not isinstance(overrides, list):
            overrides = [str(overrides)]
        two_stage = data.get("two_stage")
        if two_stage is not None and not isinstance(two_stage, dict):
            log(f"[{f.name}] WARN ignoring non-dict two_stage block: "
                f"{type(two_stage).__name__}")
            two_stage = None
        log(f"[{f.name}] submitting experiment={exp} overrides={overrides}"
            + (f" two_stage={two_stage}" if two_stage else ""))

        try:
            meta = _submit_one(
                exp, [str(o) for o in overrides], two_stage=two_stage,
            )
        except subprocess.CalledProcessError as e:
            err = (e.stderr or e.stdout or "")[-2000:]
            log(f"[{f.name}] FAILED: {err.strip()[:500]}")
            failed_dir.mkdir(parents=True, exist_ok=True)
            target = failed_dir / f.name
            shutil.move(str(f), str(target))
            with target.open("a") as fh:
                fh.write(f"\nerror: |\n  {err}\n")
            continue
        except Exception as e:
            log(f"[{f.name}] FAILED: {e}")
            failed_dir.mkdir(parents=True, exist_ok=True)
            target = failed_dir / f.name
            shutil.move(str(f), str(target))
            with target.open("a") as fh:
                fh.write(f"\nerror: {e}\n")
            continue

        # Annotate + move to claimed
        data.update(meta)
        claimed_dir.mkdir(parents=True, exist_ok=True)
        target = claimed_dir / f.name
        _write_yaml(target, data)
        f.unlink()
        log(
            f"[{f.name}] submitted: group={meta['wandb_group']} "
            f"array={meta['slurm_array_id']} runs={meta['expected_run_count']}"
        )
        n_processed += 1
    return n_processed


# ---------------------------------------------------------------------------
# (4) Run monitor cycle
# ---------------------------------------------------------------------------
def run_monitor_cycle() -> None:
    cmd = [
        UV, "run", "--no-sync", "python", "-m",
        "JacobianODE.jacobians.tuning.monitor",
    ]
    env = os.environ.copy()
    env["SWEEPS_DIR"] = str(SWEEPS_DIR)
    try:
        run(cmd, cwd=JACODE_REPO, check=True, env=env)
    except subprocess.CalledProcessError as e:
        log(f"monitor cycle FAILED: {(e.stderr or '').strip()[:500]}")


# ---------------------------------------------------------------------------
# (5) Dispatch analysis sbatches for new sentinels
# ---------------------------------------------------------------------------
def _list_done_sentinels() -> list[Path]:
    done_dir = SWEEPS_DIR / "done"
    if not done_dir.exists():
        return []
    return sorted(p for p in done_dir.iterdir() if p.name.endswith(".done.json"))


def dispatch_pending_analyses(inflight: dict) -> int:
    log_dir = SWEEPS_DIR / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    n_new = 0
    for sentinel in _list_done_sentinels():
        group = sentinel.name[: -len(".done.json")]
        if group in inflight:
            continue
        job_name = f"analyze_{group}"
        wrap = (
            f"cd {JACODE_REPO} && OPENBLAS_NUM_THREADS=4 {UV} run --no-sync "
            f"python -m JacobianODE.jacobians.tuning.analyze_sweep {group}"
        )
        sbatch_cmd = [
            "sbatch", "--parsable",
            f"--partition={ANALYZE_PARTITION}",
            f"--gpus-per-node={ANALYZE_GPUS}",
            f"--cpus-per-task={ANALYZE_CPUS}",
            f"--mem={ANALYZE_MEM_GB}GB",
            f"--time={ANALYZE_TIMEOUT_MIN}",
            f"--job-name={job_name}",
            f"--output={log_dir}/{job_name}_%j.out",
            f"--error={log_dir}/{job_name}_%j.err",
            f"--wrap={wrap}",
        ]
        try:
            out = run(sbatch_cmd, check=True).stdout.strip()
        except subprocess.CalledProcessError as e:
            log(f"[analysis-sbatch {group}] FAILED: {(e.stderr or '').strip()[:300]}")
            continue
        job_id = out.strip().split(";")[0]
        inflight[group] = {
            "slurm_job_id": job_id,
            "dispatched_at": utc_iso(),
            "sentinel_path": str(sentinel),
        }
        log(f"[analysis-sbatch {group}] submitted as {job_id}")
        n_new += 1
    return n_new


# ---------------------------------------------------------------------------
# (6) Reap completed analyses
# ---------------------------------------------------------------------------
def _slurm_job_alive(job_id: str) -> bool:
    out = run(["squeue", "-j", job_id, "-h", "-o", "%T"], check=False).stdout.strip()
    return bool(out)


def _slurm_job_succeeded(job_id: str) -> bool:
    """Return True iff the SLURM job's terminal state is COMPLETED.

    Uses sacct (state-tracking, persists past job exit). Anything else
    (FAILED / CANCELLED / TIMEOUT / OUT_OF_MEMORY / ...) means the analysis
    didn't finish cleanly and we should NOT treat it as a successful reap.
    """
    out = run(
        ["sacct", "-j", f"{job_id}.batch", "-n", "--format=State", "-P"],
        check=False,
    ).stdout.strip()
    if not out:
        # Fall back to the parent job step
        out = run(
            ["sacct", "-j", job_id, "-n", "--format=State", "-P"],
            check=False,
        ).stdout.strip()
    # State strings sometimes have trailing reason markers ("CANCELLED+", "CANCELLED by 0").
    # Just check the leading word.
    state_word = out.split()[0].rstrip("+") if out else ""
    return state_word == "COMPLETED"


def _render_report(analysis_dir: Path) -> None:
    cmd = [
        UV, "run", "--no-sync", "python", "-m",
        "JacobianODE.jacobians.tuning.render_report",
        str(analysis_dir),
    ]
    run(cmd, cwd=JACODE_REPO, check=True)


def _publish_analysis(group: str) -> Path | None:
    """Render report + copy analysis dir into the repo at <project>/<group>/.

    Returns the in-repo path, or None on failure.
    """
    analysis_dir = SWEEPS_DIR / "analysis" / group
    if not (analysis_dir / "metrics.json").exists():
        return None
    _render_report(analysis_dir)
    ctx = json.loads((analysis_dir / "context.json").read_text())
    project = ctx["wandb"].get("project")
    if not project:
        log(f"[publish {group}] context.json has no wandb.project")
        return None
    target = REPO_DIR / project / group
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        shutil.rmtree(target)
    # Copy everything (figures/, *.json, *.md, *.html, *.log)
    shutil.copytree(analysis_dir, target)
    return target


def _maybe_dispatch_stage_b(group: str) -> None:
    """Two-stage protocol auto-dispatch hook.

    Called after a Stage A analysis report publishes. If the group's
    expected.json has a ``two_stage:`` block (set by the instruction YAML),
    shells out to the cull tool with those params. The cull tool selects
    survivors, dispatches per-survivor j-submits, and writes an
    idempotency sentinel so a controller restart can't double-fire.

    Failures are logged and swallowed — the user can re-run the cull tool
    by hand to debug. Stage A's report is already published so no data
    is lost.
    """
    if not group.endswith("__stage_a"):
        return
    expected_path = SWEEPS_DIR / "active" / f"{group}.expected.json"
    if not expected_path.is_file():
        return
    try:
        spec = json.loads(expected_path.read_text()).get("two_stage")
    except Exception as e:
        log(f"[two_stage {group}] could not read expected.json: {e}")
        return
    if not spec:
        return  # opt-in only

    # Idempotency: cull tool writes this on success. If it's already there,
    # Stage B was already dispatched (e.g. from a prior controller cycle
    # before a restart) and we shouldn't re-fire.
    sentinel = SWEEPS_DIR / "active" / f"{group}.stage_b_dispatched"
    if sentinel.is_file():
        log(f"[two_stage {group}] already dispatched (sentinel exists), "
            "skipping")
        return

    cmd = [
        UV, "run", "--no-sync", "python", "-m",
        "JacobianODE.jacobians.tuning.two_stage_cull",
        "--group", group,
        "--full-max-epochs", str(spec["full_max_epochs"]),
        "--cull-fraction", str(spec.get("cull_fraction", 0.5)),
        "--metric", spec.get("metric", "trajectory val_loss"),
    ]
    log(f"[two_stage {group}] auto-dispatching cull: {' '.join(cmd)}")
    try:
        run(cmd, cwd=JACODE_REPO, check=True)
        log(f"[two_stage {group}] cull OK")
    except subprocess.CalledProcessError as e:
        log(f"[two_stage {group}] cull FAILED ({e.returncode}): "
            f"{(e.stderr or e.stdout or '').strip()[:500]}")


def reap_completed_analyses(inflight: dict) -> int:
    n_reaped = 0
    for group in list(inflight.keys()):
        info = inflight[group]
        job_id = info["slurm_job_id"]
        if _slurm_job_alive(job_id):
            continue

        # Job no longer in queue. Verify it actually succeeded — if it was
        # CANCELLED / TIMEOUT / FAILED we MUST NOT publish because metrics.json
        # may be stale from a prior run and would silently overwrite a good
        # report with stale content.
        succeeded = _slurm_job_succeeded(job_id)
        if not succeeded:
            log(
                f"[reap {group}] sbatch {job_id} did not COMPLETE — "
                f"moving sentinel to failed/, not publishing"
            )
            sentinel = Path(info["sentinel_path"])
            dest = SWEEPS_DIR / "failed"
            dest.mkdir(parents=True, exist_ok=True)
            if sentinel.exists():
                shutil.move(str(sentinel), str(dest / sentinel.name))
            del inflight[group]
            n_reaped += 1
            continue

        try:
            published = _publish_analysis(group)
        except subprocess.CalledProcessError as e:
            log(f"[reap {group}] render_report FAILED: {(e.stderr or '').strip()[:300]}")
            published = None
        sentinel = Path(info["sentinel_path"])
        target_dir = "processed" if published else "failed"
        dest = SWEEPS_DIR / target_dir
        dest.mkdir(parents=True, exist_ok=True)
        if sentinel.exists():
            shutil.move(str(sentinel), str(dest / sentinel.name))
        if published:
            log(f"[reap {group}] OK -> {published.relative_to(REPO_DIR)}")
            try:
                _maybe_dispatch_stage_b(group)
            except Exception as e:
                # Defensive: never let two-stage dispatch crash the cycle.
                log(f"[reap {group}] two_stage dispatch hook raised: {e}")
        else:
            log(f"[reap {group}] FAILED (publish error)")
        del inflight[group]
        n_reaped += 1
    return n_reaped


# ---------------------------------------------------------------------------
# (7) Status overview
# ---------------------------------------------------------------------------
def _scan_sweep_state(sweep_subdir: str) -> list[str]:
    d = SWEEPS_DIR / sweep_subdir
    if not d.exists():
        return []
    if sweep_subdir == "active":
        return sorted({p.name[: -len(".expected.json")]
                       for p in d.iterdir() if p.name.endswith(".expected.json")})
    return sorted({p.name[: -len(".done.json")]
                   for p in d.iterdir() if p.name.endswith(".done.json")})


def _maybe_load_state_summary(group: str) -> dict | None:
    p = SWEEPS_DIR / "active" / f"{group}.state.json"
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text()).get("summary")
    except Exception:
        return None


def _build_array_to_group_map() -> dict[str, str]:
    """Build a mapping from SLURM array job ID → wandb group by reading
    the annotated instruction files in instructions/claimed/."""
    mapping: dict[str, str] = {}
    claimed_dir = REPO_DIR / "instructions" / "claimed"
    if not claimed_dir.exists():
        return mapping
    for f in claimed_dir.iterdir():
        if f.suffix != ".yaml":
            continue
        try:
            data = _read_yaml(f)
            aid = str(data.get("slurm_array_id", "")).strip("'\"")
            group = data.get("wandb_group", "")
            if aid and group:
                mapping[aid] = group
        except Exception:
            continue
    return mapping


def _count_array_tasks(job_id: str) -> int:
    """Count how many array tasks ``job_id`` refers to.

    SLURM squeue compresses pending tasks into one row using a bracket spec
    that may be a single task (``job_11``), a range (``job_[11-39]``), or a
    comma-separated list with optional ranges and a ``%K`` concurrency
    suffix (``job_[2,12-39%45]``). Parse all of those.
    """
    # Running tasks have no brackets: ``jobid_11``.
    if "[" not in job_id:
        return 1
    # Extract the bracket content.
    m = re.search(r"\[([^\]]+)\]", job_id)
    if not m:
        return 1
    content = m.group(1)
    # Strip ``%K`` concurrency limit if present.
    content = content.split("%", 1)[0]
    total = 0
    for piece in content.split(","):
        piece = piece.strip()
        if not piece:
            continue
        if "-" in piece:
            try:
                lo_s, hi_s = piece.split("-", 1)
                lo, hi = int(lo_s), int(hi_s)
                total += max(0, hi - lo + 1)
            except ValueError:
                continue
        else:
            try:
                int(piece)
                total += 1
            except ValueError:
                continue
    return total if total > 0 else 1


def _get_squeue_info() -> tuple[dict[str, dict], dict[str, dict]]:
    """Query SLURM for running/pending jobs.

    Returns (per_group_jobs, analysis_jobs) where:
    - per_group_jobs maps wandb_group -> {n_running, n_pending, n_total}
      for training jobs (matched via claimed instruction array IDs).
    - analysis_jobs maps group -> {n_running, n_pending} for analyze_* jobs.
    """
    try:
        out = run(
            # ``-r`` expands array tasks into one row per task. Without it
            # SLURM compresses pending tasks into a bracket spec like
            # ``12125132_[3,5-6,12-13,15,18-24,30-...]`` — and squeue's %i
            # field truncates that *value* even when the column is widened
            # (the padding is just visual), so any bracket parsing
            # downstream sees a chopped string. With ``-r`` every task is
            # its own row and we just count rows.
            ["squeue", "-u", os.environ.get("USER", "eisenaj"),
             "-r", "-h", "-o", "%i %j %T"],
            check=False,
        ).stdout
    except FileNotFoundError:
        return {}, {}

    array_to_group = _build_array_to_group_map()

    per_group: dict[str, dict] = {}
    analysis: dict[str, dict] = {}

    for line in out.strip().splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        job_id, name, state = parts[0], parts[1], parts[2]

        if name.startswith("analyze_"):
            group = name[len("analyze_"):]
            entry = analysis.setdefault(group, {"n_running": 0, "n_pending": 0})
            if state == "RUNNING":
                entry["n_running"] += 1
            elif state == "PENDING":
                entry["n_pending"] += 1
        else:
            # Training job. Extract base array ID (e.g. "11963268" from
            # "11963268_0" or "11963268_[1-5%6]").
            base_id = re.match(r"(\d+)", job_id)
            if not base_id:
                continue
            group = array_to_group.get(base_id.group(1))
            if not group:
                continue
            entry = per_group.setdefault(group, {"n_running": 0, "n_pending": 0, "n_total": 0})
            count = _count_array_tasks(job_id)
            entry["n_total"] += count
            if state == "RUNNING":
                entry["n_running"] += count
            elif state == "PENDING":
                entry["n_pending"] += count

    return per_group, analysis


def update_status_overview(inflight: dict) -> bool:
    """Returns True if status/overview.json changed."""
    overview = {
        "schema_version": 1,
        "last_updated": utc_iso(),
        "sweeps": {},
    }

    # Collect groups from each state dir. Higher-priority states override:
    # processed > failed > done > active.
    group_status: dict[str, str] = {}
    for status, sub in [("active", "active"), ("done", "done"),
                         ("failed", "failed"), ("processed", "processed")]:
        for group in _scan_sweep_state(sub):
            group_status[group] = status

    training_jobs, analysis_jobs = _get_squeue_info()

    # Also scan instruction dirs for pending/claimed sweeps
    pending_instructions = []
    for sub in ("pending", "claimed"):
        d = REPO_DIR / "instructions" / sub
        if d.exists():
            for f in sorted(d.iterdir()):
                if f.suffix == ".yaml":
                    pending_instructions.append({"file": f.name, "status": sub})

    for group, status in sorted(group_status.items()):
        entry: dict = {"status": status}
        summary = _maybe_load_state_summary(group)
        if summary is not None:
            entry["runs_summary"] = summary
        if group in inflight:
            entry["analysis"] = {
                "slurm_job_id": inflight[group]["slurm_job_id"],
                "dispatched_at": inflight[group]["dispatched_at"],
                "status": "running",
            }
        if group in analysis_jobs:
            entry["analysis_slurm"] = analysis_jobs[group]
        if group in training_jobs:
            entry["training_slurm"] = training_jobs[group]
            # If there are live SLURM training jobs, the group is active
            # even if its sentinel has been processed (e.g. new runs were
            # added to the same group after the original analysis).
            if training_jobs[group].get("n_total", 0) > 0:
                entry["status"] = "active"
        overview["sweeps"][group] = entry

    if pending_instructions:
        overview["pending_instructions"] = pending_instructions

    # Always write so the dashboard shows a fresh heartbeat timestamp.
    # The diff is just one line (last_updated) on no-change cycles.
    target = REPO_DIR / "status" / "overview.json"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(overview, indent=2) + "\n")
    return True


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--dry-run", action="store_true",
                    help="run all steps but skip git push")
    args = ap.parse_args()

    lock = acquire_lock()
    log(f"controller cycle start  (host={HOSTNAME}  dry_run={args.dry_run})")

    try:
        try:
            git_pull_rebase()
        except subprocess.CalledProcessError as e:
            log(f"git pull failed: {(e.stderr or '').strip()[:300]} — aborting cycle")
            return 1

        # Pull JacobianODE so monitor/analyze_sweep/prepare_sweep are current.
        # Critical: this controller script also lives in the repo (since the
        # in-repo move), so updating it requires the next cron tick to pull.
        git_pull_jacode()

        n_new = process_pending_instructions(args.dry_run)
        if n_new:
            log(f"processed {n_new} instruction(s)")
        run_monitor_cycle()

        inflight = load_inflight()
        n_disp = dispatch_pending_analyses(inflight)
        n_reaped = reap_completed_analyses(inflight)
        save_inflight(inflight)
        if n_disp or n_reaped:
            log(f"analyses: dispatched={n_disp}  reaped={n_reaped}  "
                f"in_flight_total={len(inflight)}")

        changed = update_status_overview(inflight)
        if changed:
            log("status/overview.json updated")

        # Rebuild the dashboard manifest so the GitHub Pages site picks up
        # new/updated reports.
        manifest_script = REPO_DIR / "build_manifest.py"
        if manifest_script.exists():
            try:
                run([sys.executable, str(manifest_script)], cwd=REPO_DIR, check=True)
            except subprocess.CalledProcessError as e:
                log(f"build_manifest.py failed: {(e.stderr or '').strip()[:200]}")

        try:
            git_commit_and_push(f"controller cycle {utc_iso()}", args.dry_run)
        except subprocess.CalledProcessError as e:
            log(f"git push failed: {(e.stderr or '').strip()[:300]}")
            return 2
    finally:
        log("controller cycle end")
    return 0


if __name__ == "__main__":
    sys.exit(main())
