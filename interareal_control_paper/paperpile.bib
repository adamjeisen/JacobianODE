  urldate      = {2026-02-26},
  keywords     = {Datasets}
}

@ARTICLE{Jiang2025-fo,
  title        = {{SEED}-{VII}: A multimodal dataset of six basic emotions with
                  continuous labels for emotion recognition},
  author       = {Jiang, Wei-Bang and Liu, Xuan-Hao and Zheng, Wei-Long and Lu,
                  Bao-Liang},
  journaltitle = {IEEE Trans. Affect. Comput.},
