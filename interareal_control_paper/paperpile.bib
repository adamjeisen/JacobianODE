@ARTICLE{Barmpas2025-di,
  title        = {{NeuroRVQ}: Multi-scale {EEG} tokenization for generative
                  large brainwave models},
  author       = {Barmpas, Konstantinos and Lee, Na and Koliousis, Alexandros
                  and Panagakis, Yannis and Adamos, Dimitrios A and Laskaris,
