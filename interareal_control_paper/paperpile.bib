}

@ARTICLE{Cakan2021-ym,
  title        = {Spatiotemporal Patterns of Adaptation-Induced Slow
                  Oscillations in a Whole-Brain Model of Slow-Wave Sleep},
  author       = {Cakan, Caglar and Dimulescu, Cristiana and Khakimova, Liliia
