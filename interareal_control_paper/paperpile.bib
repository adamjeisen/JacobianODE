  doi          = {10.1016/j.plrev.2020.01.004},
  abstract     = {What is social pressure, and how could it be adaptive to
                  conform to others' expectations? Existing accounts highlight
                  the importance of reputation and social sanctions. Yet,
                  conformist behavior is multiply determined: sometimes, a
                  person desires social regard, but at other times she feels
