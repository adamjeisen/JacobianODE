  date         = {2016},
  doi          = {10.1016/j.neuron.2016.02.028},
  abstract     = {Working memory is thought to result from sustained neuron
                  spiking. However, computational models suggest complex
                  dynamics with discrete oscillatory bursts. We analyzed local
                  field potential (LFP) and spiking from the prefrontal cortex
