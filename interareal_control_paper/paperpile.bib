  keywords     = {Brain-computer interface; Functional magnetic resonance
                  imaging; Neurofeedback; Neuroimaging; Psychiatric disorders;
                  Real-time fMRI;clinical psych},
  language     = {en}
}

@ARTICLE{Tursic2020-pt,
