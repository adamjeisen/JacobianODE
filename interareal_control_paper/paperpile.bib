                  dynamics with suppressed temporal complexity.},
  keywords     = {DFA; LRTC; alpha; neuronal oscillations; performance;Attention
                  + Meditation Stability;attention;stability},
  language     = {en}
}

@ARTICLE{Fagerholm2015-vt,
  title        = {Cascades and cognitive state: focused attention incurs
                  subcritical dynamics},
  author       = {Fagerholm, Erik D and Lorenz, Romy and Scott, Gregory and
                  Dinov, Martin and Hellyer, Peter J and Mirzaei, Nazanin and
