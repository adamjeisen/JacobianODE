  journaltitle = {Emotion},
  volume       = {22},
  issue        = {1},
  pages        = {30--45},
  date         = {2022-02},
  doi          = {10.1037/emo0001035},
  abstract     = {The positivity resonance theory of coexperienced positive
                  affect (Fredrickson, 2016) identifies the emotion of love as a
