@ARTICLE{Maschke2024-nx,
  title        = {Critical dynamics in spontaneous {EEG} predict
                  anesthetic-induced loss of consciousness and perturbational
                  complexity},
  author       = {Maschke, Charlotte and O'Byrne, Jordan and Colombo, Michele
                  Angelo and Boly, Melanie and Gosseries, Olivia and Laureys,
