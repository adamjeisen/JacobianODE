@ARTICLE{Safavi2023-nd,
  title        = {Uncovering the organization of neural circuits with
                  Generalized Phase Locking Analysis},
  author       = {Safavi, Shervin and Panagiotaropoulos, Theofanis I and Kapoor,
                  Vishal and Ramirez-Villegas, Juan F and Logothetis, Nikos K
