@INPROCEEDINGS{Karniol-Tambour2023-ti,
  title     = {Modeling state-dependent communication between brain regions with
               switching nonlinear dynamical systems},
  author    = {Karniol-Tambour, Orren and Zoltowski, David M and Mika Diamanti,
