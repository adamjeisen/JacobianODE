  date         = {2012-11-30},
  doi          = {10.3389/fphys.2012.00450},
  abstract     = {Recent years of research have shown that the complex temporal
                  structure of ongoing oscillations is scale-free and
                  characterized by long-range temporal correlations. Detrended
                  fluctuation analysis (DFA) has proven particularly useful,
                  revealing that genetic variation, normal development, or
