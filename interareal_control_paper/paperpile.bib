@THESIS{Congedo2026-au,
  title       = {Pseudo Affine-Invariant Riemannian Metrics for Efficient
                 Brain-Computer Interfaces},
  author      = {Congedo, Marco},
  publisher   = {GIPSA-lab, University Grenoble Alpes, CNRS, Grenoble-INP},
