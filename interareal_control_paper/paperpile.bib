  volume       = {44},
  issue        = {7},
  pages        = {1511--1519},
  date         = {2014-05},
  doi          = {10.1017/S0033291713001748},
  abstract     = {BACKGROUND: Sleep benefits memory consolidation. Here, we
                  tested the beneficial effect of sleep on memory consolidation
                  following exposure psychotherapy of phobic anxiety. METHOD: A
                  total of 40 individuals afflicted with spider phobia according
                  to DSM-IV underwent a one-session virtual reality exposure
                  treatment and either slept for 90 min or stayed awake
                  afterwards. RESULTS: Sleep following exposure therapy compared
                  with wakefulness led to better reductions in self-reported
                  fear (p = 0.045, d = 0.47) and catastrophic spider-related
                  cognitions (p = 0.026, d = 0.53) during approaching a live
                  spider, both tested after 1 week. Both reductions were
                  associated with greater percentages of stage 2 sleep.
                  CONCLUSIONS: Our results indicate that sleep following
                  successful psychotherapy, such as exposure therapy, improves
                  therapeutic effectiveness, possibly by strengthening new
                  non-fearful memory traces established during therapy. These
                  findings offer an important non-invasive alternative to recent
                  attempts to facilitate therapeutic memory extinction and
                  consolidation processes with pharmacological or behavioral
                  interventions.},
  keywords     = {Engineering Sleep and Dreams},
  language     = {en}
}

@ARTICLE{Moore2019-wf,
  title        = {The Effect of Induced and Chronic Pain on Attention},
  author       = {Moore, David J and Meints, Samantha M and Lazaridou, Asimina
                  and Johnson, Devin and Franceschelli, Olivia and Cornelius,
                  Marise and Schreiber, Kristin and Edwards, Robert R},
  journaltitle = {J. Pain},
  volume       = {20},
  issue        = {11},
