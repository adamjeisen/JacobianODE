  doi          = {10.1111/ejn.13672},
  abstract     = {Neuronal oscillations exhibit complex amplitude fluctuations
                  with autocorrelations that persist over thousands of
                  oscillatory cycles. Such long-range temporal correlations
                  (LRTC) are thought to reflect neuronal systems poised near a
