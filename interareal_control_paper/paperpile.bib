@ARTICLE{Fard2016-kf,
  title        = {Not just a colourful metaphor: modelling the landscape of
                  cellular development using Hopfield networks},
  author       = {Fard, Atefeh Taherian and Srihari, Sriganesh and Mar, Jessica
