  journaltitle = {Anesthesiology},
  volume       = {130},
  issue        = {6},
  pages        = {898--911},
  date         = {2019-06},
  doi          = {10.1097/ALN.0000000000002704},
  abstract     = {BACKGROUND: A key feature of the human brain is its capability
                  to adapt flexibly to changing external stimuli. This
                  capability can be eliminated by general anesthesia, a state
                  characterized by unresponsiveness, amnesia, and (most likely)
                  unconsciousness. Previous studies demonstrated decreased
