@ARTICLE{aan-het-Rot2010-xe,
  title        = {Safety and efficacy of repeated-dose intravenous ketamine for
                  treatment-resistant depression},
  author       = {aan het Rot, Marije and Collins, Katherine A and Murrough,
                  James W and Perez, Andrew M and Reich, David L and Charney,
