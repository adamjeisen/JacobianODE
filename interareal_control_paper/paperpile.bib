  language     = {en}
}

@ARTICLE{Mikhaeil2021-rt,
  title        = {On the difficulty of learning chaotic dynamics with {RNNs}},
  author       = {Mikhaeil, Jonas M and Monfared, Zahra and Durstewitz, Daniel},
