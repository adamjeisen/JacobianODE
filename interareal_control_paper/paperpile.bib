  date         = {2021-01-27},
  doi          = {10.1038/s41467-020-20197-x},
  abstract     = {Motor function depends on neural dynamics spanning multiple
                  spatiotemporal scales of population activity, from spiking of
                  neurons to larger-scale local field potentials (LFP). How
                  multiple scales of low-dimensional population dynamics are
                  related in control of movements remains unknown. Multiscale
                  neural dynamics are especially important to study in
