@INPROCEEDINGS{Li2023-ii,
  title     = {The Lazy Neuron Phenomenon: On Emergence of Activation Sparsity
               in Transformers},
  author    = {Li, Zonglin and You, Chong and Bhojanapalli, Srinadh and Li,
               Daliang and Rawat, Ankit Singh and Reddi, Sashank J and Ye, Ke
