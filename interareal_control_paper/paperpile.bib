@ARTICLE{Malekmohammadi2018-oa,
  title        = {Propofol-induced changes in α-β sensorimotor cortical
                  connectivity},
  author       = {Malekmohammadi, Mahsa and AuYong, Nicholas and Price, Collin M
                  and Tsolaki, Evangelia and Hudson, Andrew E and Pouratian,
