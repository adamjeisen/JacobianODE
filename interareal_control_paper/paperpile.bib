@ARTICLE{McCarthy2008-pe,
  title        = {Potential network mechanisms mediating electroencephalographic
                  beta rhythm changes during propofol-induced paradoxical
                  excitation},
  author       = {McCarthy, Michelle M and Brown, Emery N and Kopell, Nancy},
