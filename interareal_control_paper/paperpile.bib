}

@ARTICLE{Arzi2014-we,
  title        = {Olfactory aversive conditioning during sleep reduces
                  cigarette-smoking behavior},
  author       = {Arzi, Anat and Holtzman, Yael and Samnon, Perry and Eshel,
                  Neetai and Harel, Edo and Sobel, Noam},
  journaltitle = {J. Neurosci.},
  volume       = {34},
  issue        = {46},
  pages        = {15382--15393},
  date         = {2014-11-12},
  doi          = {10.1523/JNEUROSCI.2291-14.2014},
  abstract     = {Recent findings suggest that novel associations can be learned
                  during sleep. However, whether associative learning during
                  sleep can alter later waking behavior and whether such
                  behavioral changes last for minutes, hours, or days remain
                  unknown. We tested the hypothesis that olfactory aversive
                  conditioning during sleep will alter cigarette-smoking
