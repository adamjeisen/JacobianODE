@ARTICLE{Suweis2019-pb,
  title        = {Brain controllability: Not a slam dunk yet},
  author       = {Suweis, Samir and Tu, Chengyi and Rocha, Rodrigo P and
                  Zampieri, Sandro and Zorzi, Marzo and Corbetta, Maurizio},
  journaltitle = {Neuroimage},
