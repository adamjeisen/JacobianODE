  author       = {Shitara, Hitoshi and Hiroki, Tadanao and Koda, Ren and Sasaki,
                  Tsuyoshi and Kamiyama, Masataka and Miyamoto, Ryosuke and
                  Nakase, Kurumi and Ino, Fukuhisa and Kachi, Takuma and Mieda,
                  Rie and Aso, Chizu and Yamakoshi, Yoshiki and Saito, Shigeru
