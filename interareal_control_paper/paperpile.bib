  doi          = {10.1038/s41398-021-01333-7},
  abstract     = {The local recurrent collateral connections between cortical
                  neurons provide a basis for attractor neural networks for
                  memory, attention, decision-making, and thereby for many
                  aspects of human behavior. In schizophrenia, a reduction of
                  the firing rates of cortical neurons, caused for example by
                  reduced NMDA receptor function or reduced spines on neurons,
