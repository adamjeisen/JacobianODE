@ARTICLE{Banville2025-yo,
  title        = {Scaling laws for decoding images from brain activity},
  author       = {Banville, Hubert and Benchetrit, Yohann and d'Ascoli, Stéphane
                  and Rapin, Jérémy and King, Jean-Rémi},
  journaltitle = {arXiv [eess.IV]},
  date         = {2025-01-25},
