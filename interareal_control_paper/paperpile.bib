  date         = {2022-02-25},
  doi          = {10.1126/science.abh3021},
  abstract     = {Sleep quality declines with age; however, the underlying
                  mechanisms remain elusive. We found that hyperexcitable
                  hypocretin/orexin (Hcrt/OX) neurons drive sleep fragmentation
                  during aging. In aged mice, Hcrt neurons exhibited more
