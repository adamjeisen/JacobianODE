  doi          = {10.7554/eLife.17089},
  abstract     = {Anticipating the future is a key motif of the brain, possibly
                  supported by mental simulation of upcoming events. Rodent
                  single-cell recordings suggest the ability of spatially tuned
                  cells to represent subsequent locations. Grid-like
                  representations have been observed in the human entorhinal
