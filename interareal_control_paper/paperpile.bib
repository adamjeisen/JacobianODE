  volume       = {40},
  issue        = {1},
  pages        = {5--14},
  date         = {2011-02-19},
  doi          = {10.1080/16506073.2010.515187},
  abstract     = {A growing body of literature suggests that worry is a
                  cognitive activity functioning to avoid unpleasant internal
                  experiences such as negative thoughts, emotions, and somatic
                  responses. Given the highly aversive internal events
                  associated with posttraumatic stress disorder (PTSD),
                  individuals experiencing PTSD symptoms following exposure to a
