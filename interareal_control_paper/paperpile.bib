  doi          = {10.1523/JNEUROSCI.3694-14.2015},
  abstract     = {The analysis of neuronal avalanches supports the hypothesis
                  that the human cortex operates with critical neural dynamics.
                  Here, we investigate the relationship between cascades of
                  activity in electroencephalogram data, cognitive state, and
                  reaction time in humans using a multimodal approach. We
