@ARTICLE{Salfenmoser2022-sk,
  title        = {Nonlinear optimal control of a mean-field model of neural
                  population dynamics},
  author       = {Salfenmoser, Lena and Obermayer, Klaus},
  journaltitle = {Front. Comput. Neurosci.},
