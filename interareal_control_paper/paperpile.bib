}

@ARTICLE{Yang2021-da,
  title        = {Modelling and prediction of the dynamic responses of
                  large-scale brain networks during direct electrical
                  stimulation},
  author       = {Yang, Yuxiao and Qiao, Shaoyu and Sani, Omid G and Sedillo, J
