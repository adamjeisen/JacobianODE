@ARTICLE{Munn2023-oo,
  title        = {A thalamocortical substrate for integrated information via
                  critical synchronous bursting},
  author       = {Munn, Brandon R and Müller, Eli J and Aru, Jaan and Whyte,
                  Christopher J and Gidon, Albert and Larkum, Matthew E and
                  Shine, James M},
  journaltitle = {Proc. Natl. Acad. Sci. U. S. A.},
