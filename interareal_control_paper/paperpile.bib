  date         = {2005-03},
  doi          = {10.1016/j.neuroimage.2004.11.017},
  abstract     = {We propose Granger causality mapping (GCM) as an approach to
                  explore directed influences between neuronal populations
                  (effective connectivity) in fMRI data. The method does not
                  rely on a priori specification of a model that contains
                  pre-selected regions and connections between them. This
                  distinguishes it from other fMRI effective connectivity
                  approaches that aim at testing or contrasting specific
                  hypotheses about neuronal interactions. Instead, GCM relies on
